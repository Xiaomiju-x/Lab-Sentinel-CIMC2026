  "input_binding": {
    "frozen_contract": "SEM_image_acquisition_settings_noise_blur_charging_features",
    "allowed_fields": [
      "Noise_level",
      "Contrast_level",
      "Mean_intensity",
      "Std_intensity",
      "Variance_intensity",
      "Michelson_contrast",
      "RMS_contrast",
      "Edge_density",
      "fft_high_frequency_ratio",
      "laplacian_variance",
      "charging_low_frequency_energy_ratio"
    ],
    "forbidden_mask_or_target_derived_fields": [
      "DICE-COEFFICIENT",
      "TRUE POSITIVE",
      "TRUE NEGATIVE",
      "FALSE POSITIVE",
      "FALSE NEGATIVE",
      "SNR1",
      "SNR2",
      "SNR3",
      "SNR4",
      "SNR5",
      "SNR6",
      "SNR7",
      "SNR8",
      "SNR9",
      "SNR10",
      "Foreground_mean",
      "Background_mean",
      "Foreground_var",
      "Background_var",
      "SSIM",
      "PSNR",
      "MI",
      "NMI",
      "CE"
    ],
    "raw_image_feature_rules": {
      "fft_high_frequency_ratio": "After subtracting image mean, sum 2-D FFT power at normalized radial frequency >=0.25 and divide by all non-DC power.",
      "laplacian_variance": "Variance of the four-neighbour discrete Laplacian divided by image intensity variance plus 1e-12.",
      "charging_low_frequency_energy_ratio": "After subtracting image mean, sum 2-D FFT power at 0<normalized radial frequency<=0.05 and divide by all non-DC power. This is a charging-halo proxy, not a physical charging label."
    }
  },
  "target_binding": {
    "frozen_contract": "quality_score_and_usable_unusable_flag",
    "quality_score": "Arithmetic mean of the three official AI3/AI5/AI7 DICE-COEFFICIENT values for the same IMAGE-NAME.",
    "usable_flag": "quality_score >= 0.90 and minimum(AI3,AI5,AI7 DICE-COEFFICIENT) >= 0.85",
    "label_provenance": "Official NIST segmentation-observer accuracy joined by exact IMAGE-NAME; no teacher/API label."
  },
  "split_binding": {
    "group_key": "Noise_level",
    "assignment": "Sort the 27 unique noise groups by SHA-256('forge200-p099-nist-v1|noise=' + canonical integer); first 19=train, next 4=validation, final 4=test.",
    "expected_group_counts": {
      "train": 19,
      "validation": 4,
      "test": 4
    },
    "expected_record_counts": {
      "train": 399,
      "validation": 84,
      "test": 84
    },
    "test_policy": "The test partition is evaluated once only after feature extraction, validation-only model selection, three-seed training and W8 export are complete."
  },
  "baseline_binding": {
    "name": "Fourier_sharpness_threshold",
    "score": "fft_high_frequency_ratio",
    "threshold_selection": "Choose threshold and direction on validation only by maximum balanced accuracy; test is not visible during selection.",
    "comparison_metrics": [
      "Spearman_rho_quality_score",
      "usable_AUROC",
      "false_reject_rate"
    ]
  },
